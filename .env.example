# setup_evaluation.py creates local engine settings in .env.
# Add provider settings to your shell or an ignored .env-credentials file.
# Azure deployment names must match the models selected by the benchmark.
# AZURE_API_KEY=
# AZURE_API_BASE=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_API_VERSION=
# Langroid clients (MALADE/information flow) use these corresponding settings:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_BASE=https://YOUR-RESOURCE.openai.azure.com/
# QDRANT_API_URL=http://localhost:6333
# QDRANT_API_KEY=
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=
# OPENAI_API_KEY=
# OPENFDA_API_KEY=
# Authenticate Vertex with: gcloud auth application-default login
# Do not commit credentials, generated certificates, or live graph databases.
