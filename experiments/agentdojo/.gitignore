# Run results and logs go to outputs/agentdojo/ at the repository root by
# default (ignored there). These patterns cover results, logs and decision
# files written here when a run is pointed at this directory.
runs-live/
runs-live-*.log
retry-shard.log
decisions.jsonl
*.log

# scratch comparison trees built with `cp -al` for summarize_live --paired
.*cmp*/
